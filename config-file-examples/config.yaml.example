---
# Hubverse Dashboard Configuration
# For detailed documentation on every field, run Option 0 in build_dashboard.sh
# or see: docs/source/configuration.md

# --- Data Source ---
# Set to null for local data, or provide a Hubverse-compatible GitHub repo URL.
link_to_hubverse_compatible_data: null

# --- Forecast Periods ---
forecast_periods:
  - forecast_period_id: "season-2025-2026"
    start_date: "2025-08-01T00:00:00"
    end_date: "2026-07-31T00:00:00"
    display_string: "Season 2025-2026"
    is_default_selected: true

  - forecast_period_id: "season-2024-2025"
    start_date: "2024-08-01T00:00:00"
    end_date: "2025-07-31T00:00:00"
    display_string: "Season 2024-2025"

# --- Special Forecast Periods (optional, dynamic time windows) ---
special_forecast_periods:
  - special_period_id: "last-2-weeks"
    display_string: "Last 2 Weeks"
    time_anchor:
      anchor_on: "season-2025-2026"
      range_calculation: -1

# --- Location ---
is_single_location_forecast: false
# single_location_mapping: "06"  # Required if is_single_location_forecast is true
default_selected_location: { "US": "US" }

spatial_config:
  disable_map_in_dashboard: false
  custom_shape_file_name: null
  custom_location_mapping_file_name: "locations.csv"
  location_code_col_header_name: "location"
  location_name_col_header_name: "location_name"

# --- Targets ---
time_unit: 7  # Days between forecast points (7 = weekly)

targets:
  - target_id: "my-target"
    task_display_string: "My Forecast Target"
    target_key_in_data: "wk inc my target"
    is_default_selected: true
    # data_value_processing:       # Optional: scale/round values
    #   scaling_factor:
    #     target_data: 1.0
    #     model_output: 1.0
    #   rounding_decimals:
    #     target_data: 2
    #     model_output: 2

# --- Target Data ---
target_data_file_format: "csv"     # "csv" or "parquet"
parquet_partitioned_by_as_of: false
single_target_data_file_name: "time-series"
disable_historical_target_data: false
# as_of_column_date_shift: 0      # Shift as_of dates by N days if needed

target_data_header_mapping:
  date_col_name: "date"
  observation_col_name: "observation"
  location_col_name: "location"
  location_name_col_name: "location_name"
  target_col_name: "target"
  # as_of_col_name: "as_of"       # Enable for historical target data

# --- Model Output ---
available_models:
  "ModelA":
    color_hex: null                # Auto-assigned if null
  "ModelB":
    color_hex: "#3fc49e"

model_output_data_file_naming_standard: "ISODate"  # or "Alphanumeric"

model_output_data_header_mapping:
  reference_date_col_name: "reference_date"
  target_end_date_col_name: "target_end_date"
  target_col_name: "target"
  horizon_col_name: "horizon"
  location_col_name: "location"
  output_type_col_name: "output_type"
  output_type_id_col_name: "output_type_id"
  value_col_name: "value"

# --- Prediction Intervals ---
prediction_intervals:
  "50":
    uses_output_type_ids: ["0.25", "0.75"]
  "90":
    uses_output_type_ids: ["0.05", "0.95"]

default_selected_prediction_intervals: ["50", "90"]
horizons: [-1, 0, 1, 2, 3]
default_selected_horizon: 1

# --- Evaluation ---
baseline_model_for_relative_WIS: "ModelA"
evaluation_coverage_levels: [50, 90, 95]
# evaluation_coverage_level_for_location_map: 95

# --- UI Customization (all optional, see docs for full reference) ---
ui_customization:
  ui_header_title_name: "MyForecast"
  ui_header_nav_btn:
    - button_text: "Forecast"
      nav_to_page: "Forecast"
    - button_text: "Evaluation"
      nav_to_page: "Evaluation"

  ui_forecast_header_chart_name: "Weekly Forecast"
  # ui_forecast_header_hist_td_toggle_text: "Show Data at Time of Forecast"
  # disable_location_info_display: false

  # ui_evaluation_overview_tab_name: "Season Overview"
  # ui_evaluation_single_model_tab_name: "Single-Model"
