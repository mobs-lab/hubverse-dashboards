---
#==============================================================================
# HUBVERSE DASHBOARD CONFIGURATION FILE
#==============================================================================
# This file customizes the dashboard to work with your HubVerse-compatible data.
# The in-line comments are here to guide you through the setup process.
# Also see the full, auto-generated documentation here:
# ./docs/build/html/index.html

# LEGEND:
#   [REQUIRED]     - Must be provided, will fail otherwise
#   [CONDITIONAL]  - Required only if certain other options are set
#   [OPTIONAL]     - Has a default value or can be omitted

#==============================================================================

#==============================================================================
# DATA SOURCE CONFIGURATION
#==============================================================================
# [CONDITIONAL] You must provide EITHER local data OR a remote link.
#
# Option 1: Local Data (recommended for development)
#   - Place your data in directories named `target-data/`, `model-output/`, and `auxiliary-data/`
#     in the project root.
#   - Set link_to_hubverse_compatible_data to null.
#
# Option 2: Remote Data (for production or shared data)
#   - Provide a URL to a valid Hubverse-compatible GitHub repository containing your data.
#------------------------------------------------------------------------------

link_to_hubverse_compatible_data: "https://github.com/CDCgov/covid19-forecast-hub.git"

# Example remote configuration:
# link_to_hubverse_compatible_data: https://github.com/CDCgov/covid19-forecast-hub.git

#==============================================================================
# FORECAST PERIODS DEFINITIONS
#==============================================================================
# [REQUIRED] Define at least one time range for your forecasting data.
# Each period acts as a filter, allow for quickly viewing pre-defined time periods of data in visualizations.
#------------------------------------------------------------------------------

forecast_periods:
  # Example of a dynamic (ongoing) forecast period where the end_date is in the future.
  # Only ongoing
  # This is useful for ongoing forecasting efforts.
  - forecast_period_id: "season-2025-2026"
    start_date: "2025-08-01T00:00:00"
    end_date: "2026-07-31T00:00:00"
    display_string: "Season 2025-2026"
    is_default_selected: true # [OPTIONAL] Only one period can be true. If none are, the latest one is chosen.

  # Examples of static forecast period where the entire range is in the past.
  - forecast_period_id: "season_2024_Oct_to_2025_Feb"
    start_date: "2024-10-01T00:00:00"
    end_date: "2025-02-01T00:00:00"
    display_string: "2024 October to 2025 February"
    is_default_selected: false

  - forecast_period_id: "latest_couple_of_horizons_2025"
    start_date: "2025-08-23T00:00:00"
    end_date: "2025-09-27T00:00:00"
    display_string: "2025 Tail"
    is_default_selected: false

  - forecast_period_id: "test-season-2022-2023"
    start_date: "2022-08-01T00:00:00"
    end_date: "2023-07-31T00:00:00"
    display_string: "Test: out of range time period option"
    is_default_selected: false

#==============================================================================
# SPECIAL FORECAST PERIODS (Dynamic Time Windows)
#==============================================================================
# [OPTIONAL] Create relative time windows like "Last 2/3/4 Weeks".
# These are calculated dynamically based on the latest available data.
#
# This requires an ongoing forecast_period (one with an end_date in the future)
# to achieve dynamic update when data updates
#------------------------------------------------------------------------------

special_forecast_periods:
  - special_period_id: "last-2-weeks"
    display_string: "Last 2 Weeks"
    time_anchor:
      anchor_on: "season-2025-2026" # Must be a dynamic period ID from above
      range_calculation: -1 # Include data ranging 2 time units (weeks in this example) back from the latest valid target-data (ground truth) data date

#==============================================================================
# LOCATION DATA CONFIGURATION
#==============================================================================
# Configure how the dashboard handles geographic locations.
#------------------------------------------------------------------------------

# [OPTIONAL] Set to true if your dashboard is for a single location only.
# This simplifies the UI by removing the location selector.
is_single_location_forecast: false

# [CONDITIONAL] REQUIRED if is_single_location_forecast = true.
# Specify the location code for the single location.
single_location_mapping: "02"

#------------------------------------------------------------------------------
# Map Visualization Settings
#------------------------------------------------------------------------------

# [OPTIONAL] Default selected location when the dashboard first loads.
# If null, it will default to the first location found in your data, or "US".
# The format must be a dictionary: { "location_code": "location_name" }
default_selected_location: { "US": "US" }

# Group for spatial settings
spatial_config:
  # [OPTIONAL] If true, the geographic map visualization is hidden.
  disable_map_in_dashboard: false

  # [OPTIONAL] Path to a custom GeoJSON or TopoJSON shape file.
  # Place the file in the /auxiliary-data/ directory.
  # If null, a default US states map is used (Located at /public/states-10m.json).
  custom_shape_file_name: null

  # [RECOMMENDED] Path to a CSV file mapping location codes to names.
  # Place the file in /auxiliary-data/. This is the primary way the dashboard
  # gets location names.
  # Fallback logic: If null, names are detected from data, then from a built-in US FIPS list.
  custom_location_mapping_file_name: "locations.csv"

  # [REQUIRED if custom_location_mapping_file_name is provided]
  # Specify the column headers in your location mapping CSV file.
  location_code_col_header_name: "location"
  location_name_col_header_name: "location_name"

#==============================================================================
# MODELLING TASKS / TARGETS DEFINITIONS
#==============================================================================
# [REQUIRED] Define what you are forecasting.
#------------------------------------------------------------------------------

# [REQUIRED] The time unit in days between forecast points.
# This is crucial for calculating forecast horizons correctly.
# target_date = reference_date + (horizon * time_unit)
# Common values: 1 (daily), 7 (weekly)
time_unit: 7

# [REQUIRED] List of forecasting targets. You must define at least one.
targets:
  - target_id: "covid19-admission" # [REQUIRED] A unique machine-readable ID.
    task_display_string: "COVID19 Admissions" # [REQUIRED] Human-readable name for the UI.
    target_key_in_data: "wk inc covid hosp" # [REQUIRED] The exact string that appears in the 'target' column of your data files.
    is_default_selected: true # [OPTIONAL, unique] This target will be selected by default.

    # [OPTIONAL] Apply scaling or rounding to data values for this target.
    # Useful for converting units (e.g., proportion to percentage) or cleaning data.
    data_value_processing:
      scaling_factor:
        target_data: 1.0 # Multiply ground truth values by this factor.
        model_output: 1.0 # Multiply model output values by this factor.
      rounding_decimals:
        target_data: 2 # Round ground truth values to this many decimal places.
        model_output: 2 # Round model output values to this many decimal places.

  - target_id: "covid19-test-target"
    task_display_string: "COVID19 Admissions Test"
    target_key_in_data: "wk inc covid prop ed visits"
    data_value_processing:
      scaling_factor:
        target_data: 100 # Example: Convert a 0-1 proportion to a 0-100 percentage
        model_output: 100
      rounding_decimals:
        target_data: 2
        model_output: 2

#==============================================================================
# TARGET-DATA CONFIGURATION
#==============================================================================
# Configure how the dashboard handles your ground truth / observed data.
# See Hubverse docs for details: https://docs.hubverse.io/en/latest/user-guide/target-data.html
#------------------------------------------------------------------------------

# [OPTIONAL] File format of your ground truth data. Default: "csv"
target_data_file_format: "parquet"

# [CONDITIONAL] Required if format is "parquet".
# Set to true if your parquet data is partitioned into subdirectories by date
# (e.g., /target-data/as_of=2024-01-01/data.parquet).
parquet_partitioned_by_as_of: false

# [CONDITIONAL] Required for CSVs or non-partitioned Parquet files.
# The filename (without extension) of your single target data file.
single_target_data_file_name: "time-series"

# [Optional] Special flag for turning off the historical target data functionalities.
# Default is false. If set to true, the dashboard will:
#   - Extract only the latest 'as_of' snapshot for ground truth visualization
#   - Skip processing historical snapshots (saves processing time and storage)
#   - Disable the historical data toggle in the frontend UI
#   - Not generate the historical-target-data.json file
# Useful when you don't need historical versioning features or want faster processing.
disable_historical_target_data: false

# [Optional] Number of days to shift all "as_of" column date values. Default is 0.
# Useful when 'as_of' dates are on a different date grid than reference dates
# (e.g., as_of dates on Wednesdays while reference dates on Saturdays).
# Use negative values to shift backwards, positive to shift forwards.
# The absolute value must not exceed `time_unit` to avoid forecast cycle misalignment.
# Applies to both single-file target data and partitioned parquet files.
# NOTE: Please make sure your data's "as_of" column dates are consistent in terms of Day of Week
as_of_column_date_shift: -4

#------------------------------------------------------------------------------
# Target Data Column Mapping
#------------------------------------------------------------------------------
# [REQUIRED] Map your data file's column names to the dashboard's expected names.
target_data_header_mapping:
  date_col_name: "date" # [REQUIRED]
  observation_col_name: "observation" # [REQUIRED] The observed value. Missing data is filled with -1.
  location_col_name: "location" # [REQUIRED for multi-location]
  location_name_col_name: "location_name" # [OPTIONAL]
  target_col_name: "target" # [REQUIRED for multi-target]
  as_of_col_name: "as_of" # [CONDITIONAL] If historical target data is not disabled & not using partitioned parquet files then this is required.

#==============================================================================
# MODEL-OUTPUT CONFIGURATION
#==============================================================================
# Configure which models to display and how to read their prediction data.
#------------------------------------------------------------------------------

# [RECOMMENDED] List of models to include in the dashboard.
# Each model name here MUST match a subdirectory name in `/model-output/`.
# If this section is omitted, the dashboard will try to use all subdirectories.
available_models:
  "MOBS-GLEAM_COVID":
    color_hex: "#9ceb94" # [OPTIONAL] Hex color for charts. Auto-assigned if null.
  "CEPH-Rtrend_covid":
    color_hex: null
  "CovidHub-baseline":
    color_hex: null
  "CovidHub-ensemble":
    color_hex: null
  "NEU_ISI-AdaptiveEnsemble":
    color_hex: null
  "TEST1":
    color_hex: "#abcabc"
  "TEST2":
    color_hex: "#888888"
  "TEST3":
    color_hex: "#329abc"
  "NON-EXISTENT-MODEL": # Will show warning if directory not found
    color_hex: "#000000"

#------------------------------------------------------------------------------
# Model Output File Structure
#------------------------------------------------------------------------------

# [OPTIONAL] Model output directory naming convention (default: "ISODate")
# Options: "ISODate" (2024-01-15) or "Alphanumeric" (round-1, round-2, etc.)
model_output_data_file_naming_standard: "ISODate"

# [REQUIRED] Map your model-output column names
# See: https://docs.hubverse.io/en/latest/user-guide/model-output.html
#
# Your data MUST contain:
#   - reference_date: When forecast was made
#   - target_end_date: What date is being predicted
#   - target: What outcome is being predicted
#   - horizon: Forecast horizon value
#   - location: Where (for multi-location)
#   - output_type: Must include "quantile"
#   - output_type_id: Quantile values (0.0 to 1.0)
#   - value: Predicted value
model_output_data_header_mapping:
  reference_date_col_name: "reference_date"
  target_end_date_col_name: "target_end_date"
  target_col_name: "target"
  horizon_col_name: "horizon"
  location_col_name: "location"
  output_type_col_name: "output_type"
  output_type_id_col_name: "output_type_id"
  value_col_name: "value"

#------------------------------------------------------------------------------
# Prediction Intervals Configuration
#------------------------------------------------------------------------------

# [RECOMMENDED] Prediction intervals to display in forecast charts
# Each interval needs exactly 2 quantiles (lower and upper bounds)
# Quantiles must be between 0.0 and 1.0
prediction_intervals:
  "25": # 25% prediction interval
    uses_output_type_ids: ["0.375", "0.625"] # [REQUIRED] Ascending order
  "50":
    uses_output_type_ids: ["0.25", "0.75"]
  "75":
    uses_output_type_ids: ["0.125", "0.875"]
  "90":
    uses_output_type_ids: ["0.05", "0.95"]

# [OPTIONAL] Default selected PIs to display when dashboard first loads.
# Enter them into a list, using the same string you specified above.
# If null or commented out, will default to using all provided prediction_intervals.
default_selected_prediction_intervals: ["50", "90"]

# [REQUIRED] Forecast horizons your models produce
# Negative values = nowcasting (predicting past/present)
# Zero = same-day prediction
# Positive = future forecasting
horizons: [-1, 0, 1, 2, 3]

# [OPTIONAL] Default selected horizon.
default_selected_horizon: 3 # Single Choice Selection.

#==============================================================================
# MODEL EVALUATION CONFIGURATION
#==============================================================================
# Settings for calculating model performance metrics.
# This entire section is ignored if you run the builder with --skip-evaluations.
#------------------------------------------------------------------------------
# [REQUIRED] The model to use as a benchmark for Relative WIS calculations.
# Relative WIS = (WIS of a model) / (WIS of this baseline model).
# This model's data must exist in /model-output/, even if it's not in `available_models`.
baseline_model_for_relative_WIS: "CovidHub-baseline"

# [OPTIONAL] Define the coverage levels (in percentage) to be used for:
# 1. Calculating coverage metrics. These values populate the "Coverage" chart in the evaluations section.
#    Note: The necessary quantiles must be available in your model output data.
#    (95% requires 0.025 and 0.975 quantiles).
#
# If omitted, defaults to [50, 95].
evaluation_coverage_levels: [10, 20, 30, 40, 50, 60, 70, 80, 90, 98]

# [OPTIONAL] Define a single coverage level (in percentage) to be used specifically for Location map visualization (computing location averages for map coloring)
#
# This value can overlap with evaluation_coverage_levels or be different.
# If different, the system will calculate this coverage level in addition to the main list,
# but it will only be used for location map aggregates (not the Coverage chart).
#
# If omitted, defaults to 95.
evaluation_coverage_level_for_location_map: 95

#==============================================================================
# DASHBOARD DISPLAY SETTINGS
#==============================================================================
# [OPTIONAL] Change dashboard's UI elements, displays and information pop-ups here.
# A detailed illustration on what each configuration option controls, can be found in documentation at https://github.com/mobs-lab/hubverse-dashboard/wiki

# UI customization options grouped together
ui_customization:
  # Change Header and Navigation Buttons
  # ------------------------------------
  # Note: this component will be changed for both Forecast and Evaluation page.
  # Special Note: If your header title naming follows the convention "AbcdeForecast", the dashboard supports selectively bolding the "Abcde" part for you. Any other kind of naming will just be all bold.
  ui_header_title_name: "COVID-19Forecast"

  # Declare and change navigation buttons UI and behaviour
  # [Recommended] to have one button each for Forecast and Evaluation page.
  # Support external hyperlink option that may help directing to documentation, further resources, etc.
  ui_header_nav_btn:
    # Order of these options below will be preserved
    # An button can only direct to either external or Forecast/Evaluation, cannot be both
    - button_text: "About Epistorm" # This will become the display text
      nav_to_external: true
      nav_to_link: "https://www.epistorm.org/flu-forecast-about"
    - button_text: "COVID Forecast"
      nav_to_page: "Forecast" # Can only be "Forecast" or "Evaluation"
    - button_text: "Evaluation"
      nav_to_page: "Evaluation" # Note this will still be hidden if no-evalution mode is used
    - button_text: "TestExternal-Hubverse"
      nav_to_external: true
      nav_to_link: "https://hubverse.io"

  # Forecast Page Visualization Components Customizations
  # -----------------------------------------------------
  # [OPTIONAL] Changes chart header title for the main line chart visualization.
  ui_forecast_header_chart_name: "Weekly Hospital COVID-19 Admissions Forecast"

  # [OPTIONAL] Change chart header historical target data toggle text display.
  # Note this will still be hidden when no-historical-target-data mode is turned on.
  ui_forecast_header_hist_td_toggle_text: "Show COVID-19 Admissions at Time of Forecast"

  # [OPTIONAL] Disables the location name display on top of chart header.
  disable_location_info_display: false

  # [OPTIONAL]
  # Changes the infobutton title and text, for 2 located in Forecast page
  ui_forecast_header_infobutton_content:
    title: "Test infobutton title"
    content: "A very, very long test string. Dorum Ipsum ..."
  ui_forecast_settings_horizon_infobutton_content:
    title: "Test About Horizon"
    content: "Horizon Horizon Horizon Horizon Horizon"

  # Evaluation Page Customizations
  # -------------------------------------------------------------
  # [OPTIONAL]
  # Changes the infobutton title and text for evaluation overview page & single-model page
  ui_evaluation_overview_infobutton_content:
    title: "Season Overview"
    content: "evaluation overview page infobutton test string, test test test"
  ui_evaluation_overview_horizon_infobutton_content:
    title: "Forecast Horizons"
    content: "This is also a test."

  ui_evaluation_single_model_infobutton_content:
    title: "Single Model Evaluations"
    content: "Something something"
  ui_evaluation_single_model_horizon_infobutton_content:
    title: "Forecast Horizons"
    content: "This should be different from the text of the infobutton on overview page's horizon selector"

  # Evaluation page's tab bar UI customization. This changes what the text in the two tabs display in the built dashboard.
  # Currently we support two tabs:
  #   - "Overview", for visualizations on location-aggregated evaluation metrics
  #   - "Single-Model", for comprehensive visualizations on metrics associated with one model's performance, allowing multi-dimensional criteria filtering such as spatial & temporal.
  ui_evaluation_overview_tab_name: "Location-Aggregated Overview" # Default is "Season Overview".
  ui_evaluation_single_model_tab_name: "Single-Model Evaluation Tab" # Default is "Single-Model"

  # Evaluation Overview page UI customizations
  ui_evaluation_chart_log_mode_indicator_text: "Use Log Scale" # This changes the text display for the log scale toggle button for the two location-aggregated IQR box plots on Overview page.
  ui_evaluation_overview_location_map_title: "Location-Specific" # This string will be appended to the Evaluation Metric dynamically displayed depending on your selection on the dashboard. For example, "Location-Specific WIS/Baseline" in this case, when you select "WIS/Baseline".

  # [Optional] Location-Specific Evaluation Overview Map Color Scale customization:
  # This determines the end stops for the gradient-color scale used for the map visualization on Overview page. See documentation for a detailed explanation on which color on which end represents better/worse performance, for different metrics. Use Hex code.
  ui_evaluation_overview_location_map_color_scale:
    # These are default values, using a navy blue-white-green scheme.
    color_top: "#00495F"
    color_base: "#E9E9E9"
    color_bottom: "#6A9629"
    color_null: "#363b43" # Optional, Color for location with no data
