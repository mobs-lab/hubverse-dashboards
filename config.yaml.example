---
#==============================================================================
# HUBVERSE DASHBOARD CONFIGURATION FILE
#==============================================================================
# This file customizes the dashboard to work with your HubVerse-compatible data.
#
# LEGEND:
#   [REQUIRED]     - Must be provided, will fail otherwise
#   [CONDITIONAL]  - Required only if certain other options are set
#   [OPTIONAL]     - Has default value or can be omitted
#
# For detailed documentation and examples, see: DOCUMENTATION.md
#==============================================================================

#==============================================================================
# DATA SOURCE CONFIGURATION
#==============================================================================
# [CONDITIONAL] You must provide EITHER local directories OR remote links, not both.
#
# Option 1: Local Data (recommended for development)
#   - Create directories: ./target-data/ and ./model-output/
#   - Set link_to_hubverse_compatible_data: null
#
# Option 2: Remote Data
#   - Uncomment and configure links_to_hubverse_compatible_data below
#   - Remove or ensure local directories don't exist
#------------------------------------------------------------------------------

- link_to_hubverse_compatible_data: null

# Example remote configuration (currently commented out):
# - links_to_hubverse_compatible_data: "https://github.com/your-org/your-forecast-hub/"

#==============================================================================
# FORECAST PERIODS DEFINITIONS
#==============================================================================
# [REQUIRED] At least one. Define time ranges for your forecasting data.
#
# Each forecast period represents a distinct time range (e.g., a season).
# Periods can overlap or have gaps. Data is filtered by these date ranges.
#
# REQUIRED FIELDS per period:
#   - forecast_period_id: Unique identifier (alphanumeric + hyphens)
#   - start_date: ISO datetime string (e.g., "2024-11-16T00:00:00")
#   - end_date: ISO datetime string
#   - display_string: Human-readable name shown in dashboard
#
# OPTIONAL FIELDS:
#   - is_default_selected: Only ONE period can be true (default: most recent)
#------------------------------------------------------------------------------

- forecast_periods:
    - season-2024-2025:
        - forecast_period_id: "season-2024-2025"
        - start_date: "2024-11-16T00:00:00"
        - end_date: "2025-09-27T00:00:00"
        - display_string: "COVID-19 2024-2025 Forecast"
        - is_default_selected: True # [OPTIONAL] Only one can be true

    # Example: Dynamic forecast period (end_date in future)
    # - season-2025-2026:
    #     - forecast_period_id: "season-2025-2026"
    #     - start_date: "2025-08-01T00:00:00"
    #     - end_date: "2026-07-31T00:00:00"  # Future date = dynamic
    #     - display_string: "(Ongoing) COVID-19 Forecast 2025-2026"

#==============================================================================
# SPECIAL FORECAST PERIODS (Dynamic Time Windows)
#==============================================================================
# [OPTIONAL] Auto-aggregate data within relative time windows.
# Useful for "Last 2 Weeks", "Last Month" type views.
#
# Requires a dynamic forecast_period as time anchor.
#
# CONFIGURATION:
#   - anchor_on: ID of a dynamic forecast_period
#   - anchor_mode: "target-data" or "model-output"
#   - range_calculation: Negative integer (e.g., -2 for 2 periods back)
#------------------------------------------------------------------------------

- special_forecast_periods:
    # Example configuration (currently disabled):
    # - last-2-weeks:
    #     - special_period_id: "last-2-weeks"
    #     - display_string: "Last 2 Weeks"
    #     - time_anchor:
    #         - anchor_on: "season-2024-2025"  # Must be dynamic period
    #         - anchor_mode: "model-output"     # or "target-data"
    #         - range_calculation: -2           # Negative = backwards

#==============================================================================
# LOCATION DATA CONFIGURATION
#==============================================================================
# Configure spatial handling for your dashboard.
#------------------------------------------------------------------------------

# [OPTIONAL] Single-location mode toggle
# If True: Dashboard shows data for only one location
# If False: Auto-detects all locations from your data files
- is_single_location_forecast: False

# [CONDITIONAL] REQUIRED if is_single_location_forecast = True
# Specify the location code (e.g., US State FIPS: "01" = Alabama, "02" = Alaska)
- single_location_mapping: "02"

#------------------------------------------------------------------------------
# Map Visualization Settings
#------------------------------------------------------------------------------

# [OPTIONAL] Disable map visualizations (default: False)
# If True: Only dropdown lists shown, no geographic maps
- disable_map_in_dashboard: False

# [OPTIONAL] Custom shape file for map rendering
# Must be in GeoJSON or TopoJSON format, placed in /auxiliary-data/
# If null: Uses default US states map (states-10m.json)
- custom_shape_file_name: null

# [RECOMMENDED] Location mapping file (CSV format in /auxiliary-data/)
# Maps location codes to human-readable names
# If null: Uses default US State FIPS mapping
- custom_location_mapping_file_name: "locations.csv"

# [REQUIRED if above (custom location mapping file) provided]
# Column names in your location mapping CSV
- location_code_col_header_name: "location" # Column with location codes
- location_name_col_header_name: "location_name" # Column with location names

# [OPTIONAL] Default selected location for the dashboard to display on initial load
# Can be a string ("US") or dict ({"US":"US"})
# If not specified, defaults to first location in mapping or "US"
- default_selected_location: {"US":"US"}

#==============================================================================
# MODELLING TASKS / TARGETS DEFINITIONS
#==============================================================================
# [CONDITIONAL] Define what you're forecasting.
#------------------------------------------------------------------------------

# [OPTIONAL] Single-target mode toggle
# If True: No filtering on target column, assumes all data is one target
# If False: Must define targets below
- is_single_forecast_target: False

# [REQUIRED] Time unit in days between forecast points
# Used to calculate: target_date = reference_date + (horizon * time_unit)
# Common values: 1 (daily), 7 (weekly)
- time_unit: 7

# [CONDITIONAL] List of forecasting targets
# REQUIRED if is_single_forecast_target = False
# Each target represents a different outcome you're predicting
- targets:
    - "COVID19 Admission Value":
        - target_id: "covid19-admission" # [REQUIRED] Unique ID
        - task_display_string: "COVID19 Admissions" # [REQUIRED] Display name
        - target_key_in_data: "wk inc covid hosp" # [REQUIRED] Key in data files
        - for_forecast_periods: ["season-2024-2025"] # [OPTIONAL] Defaults to all
        - is_default_selected: True # [OPTIONAL, unique] Only one target can be default

    - "COVID19 Test 2nd Target":
        - target_id: "covid19-test-target"
        - task_display_string: "COVID19 Admissions Test"
        - target_key_in_data: "wk inc covid prop ed visits"
        - for_forecast_periods: ["season-2024-2025"]

#==============================================================================
# TARGET-DATA CONFIGURATION
#==============================================================================
# Configure how to read your ground truth / observed data.
# See: https://docs.hubverse.io/en/latest/user-guide/target-data.html
#------------------------------------------------------------------------------

# [OPTIONAL] File format (default: "csv")
# Options: "csv" or "parquet"
- target_data_file_format: "parquet"

# [CONDITIONAL] Required if target_data_file_format = "parquet"
# Is the parquet data partitioned by as_of date into subdirectories?
- parquet_partitioned_by_as_of: False

# [CONDITIONAL] Required if:
#   - format = "csv", OR
#   - format = "parquet" AND parquet_partitioned_by_as_of = False
# Filename (without extension) of your target data file
- single_target_data_file_name: "time-series"

#------------------------------------------------------------------------------
# Target Data Column Mapping
#------------------------------------------------------------------------------
# [REQUIRED] Map your CSV/parquet column names to dashboard expectations
#
# Your data MUST contain:
#   - A date column (ISO date strings)
#   - An observation column (actual values)
#
# If multi-location or multi-target:
#   - A location column (location codes)
#   - A target column (target keys matching target_key_in_data above)
#
# For historical data support (single file only):
#   - An as_of column (data version timestamps)
#------------------------------------------------------------------------------

- target_data_header_mapping:
    - date_col_name: "date" # [REQUIRED]
    - observation_col_name: "observation" # [REQUIRED]
    - location_col_name: "location" # [REQUIRED for multi-location]
    - location_name_col_name: "location_name" # [OPTIONAL] Can be enriched from mapping
    - target_col_name: "target" # [REQUIRED for multi-target]
    - as_of_col_name: "as_of" # [OPTIONAL] For historical data versioning

#==============================================================================
# MODEL-OUTPUT CONFIGURATION
#==============================================================================
# Configure which models to display and how to read prediction data.
#------------------------------------------------------------------------------

# [RECOMMENDED] List of models to include in dashboard
# Each model name must match a subdirectory in /model-output/
# If omitted: Attempts to use all subdirectories found
- available_models:
    - "MOBS-GLEAM_COVID":
        - color_hex: "#9ceb94" # [OPTIONAL] Hex color, auto-assigned if null
    - "CEPH-Rtrend_covid":
        - color_hex: null
    - "CovidHub-baseline":
        - color_hex: null
    - "CovidHub-ensemble":
        - color_hex: null
    # Add more models as needed...

#------------------------------------------------------------------------------
# Model Output File Structure
#------------------------------------------------------------------------------

# [OPTIONAL] Model output directory naming convention (default: "ISODate")
# Options: "ISODate" (2024-01-15) or "Alphanumeric" (round-1, round-2, etc.)
- model_output_data_file_naming_standard: "ISODate"

# [REQUIRED] Map your model-output column names
# See: https://docs.hubverse.io/en/latest/user-guide/model-output.html
#
# Your data MUST contain:
#   - reference_date: When forecast was made
#   - target_end_date: What date is being predicted
#   - target: What outcome is being predicted
#   - horizon: Forecast horizon value
#   - location: Where (for multi-location)
#   - output_type: Must include "quantile"
#   - output_type_id: Quantile values (0.0 to 1.0)
#   - value: Predicted value
- model_output_data_header_mapping:
    - reference_date_col_name: "reference_date"
    - target_end_date_col_name: "target_end_date"
    - target_col_name: "target"
    - horizon_col_name: "horizon"
    - location_col_name: "location"
    - output_type_col_name: "output_type"
    - output_type_id_col_name: "output_type_id"
    - value_col_name: "value"

#------------------------------------------------------------------------------
# Prediction Intervals Configuration
#------------------------------------------------------------------------------

# [RECOMMENDED] Prediction intervals to display in forecast charts
# Each interval needs exactly 2 quantiles (lower and upper bounds)
# Quantiles must be between 0.0 and 1.0
- prediction_intervals:
    - "25": # 25% prediction interval
        - uses_output_type_ids: ["0.375", "0.625"] # [REQUIRED] Ascending order
    - "50":
        - uses_output_type_ids: ["0.25", "0.75"]
    - "75":
        - uses_output_type_ids: ["0.125", "0.875"]
    - "90":
        - uses_output_type_ids: ["0.05", "0.95"]

# [OPTIONAL] Default selected prediction intervals to display on dashboard initial load
# Enter them into a list, using the same string you specified above.
# If null or commented out, will default to using all provided prediction_intervals.
- default_selected_prediction_intervals: ["50", "90"]

# [REQUIRED] Forecast horizons your models produce
# Negative values = nowcasting (predicting past/present)
# Zero = same-day prediction
# Positive = future forecasting
- horizons: [-1, 0, 1, 2, 3]

# [OPTIONAL] Default selected horizon for dashboard initial load
# If not specified, defaults to the last (furthest) horizon
- default_selected_horizon: 3

#==============================================================================
# MODEL EVALUATION CONFIGURATION
#==============================================================================
# Settings for calculating model performance metrics.
#------------------------------------------------------------------------------

# [OPTIONAL] Prediction intervals for coverage calculations
# Typically same as prediction_intervals above
- evaluations_prediction_intervals:
    - "25":
        - uses_output_type_ids: ["0.375", "0.625"]
    - "50":
        - uses_output_type_ids: ["0.25", "0.75"]
    - "75":
        - uses_output_type_ids: ["0.125", "0.875"]
    - "90":
        - uses_output_type_ids: ["0.05", "0.95"]

# [OPTIONAL] Default selected prediction intervals for Evaluations page
# Enter them into a list, using the same string you specified above.
- default_selected_prediction_intervals_for_evaluations: ["50", "90"]

# [REQUIRED] Baseline model for relative WIS calculations
# Must have a directory in /model-output/ even if not in available_models
- baseline_model_for_relative_WIS: "CovidHub-baseline"

#==============================================================================
# DASHBOARD DISPLAY SETTINGS
#==============================================================================
# [OPTIONAL] Future: Custom text, tooltips, help content
# Currently reserved for future enhancements
-
